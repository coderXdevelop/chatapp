{
  "expo": {
    "name": "LinkUP",
    "slug": "chatapp-root",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Linkup.png",
    "scheme": "linkup",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.nandan.linkup"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#070b13",
        "foregroundImage": "./assets/images/Linkup.png",
        "backgroundImage": "./assets/images/Linkup.png",
        "monochromeImage": "./assets/images/Linkup.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nandan.linkup"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070b13",
          "image": "./assets/images/Linkup.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow LinkUP to access your photos.",
          "cameraPermission": "Allow LinkUP to capture photos or videos."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow LinkUP to access your microphone for recording voice notes.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      "expo-sharing",
      "expo-web-browser",
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/Linkup.png",
          "color": "#F59E0B"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "1c680cd5-500f-4b34-b0a9-479ae61bd45a"
      }
    }
  }
}
